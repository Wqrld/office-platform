{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "domain": {"type": "string", "format": "hostname", "minLength": 1},
    "storageClass": {"type": "string", "minLength": 1},
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ip": {"type": "string", "format": "ipv4"},
        "tlsIssuer": {"type": "string", "minLength": 1}
      }
    },
    "livekit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"ip": {"type": "string", "anyOf": [{"format": "ipv4"}, {"maxLength": 0}]}}
    },
    "size": {"enum": ["small", "medium", "large"]},
    "apps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "docs": {"type": "boolean"},
        "drive": {"type": "boolean"},
        "collabora": {"type": "boolean"},
        "find": {"type": "boolean"},
        "calendars": {"type": "boolean"},
        "meet": {"type": "boolean"}
      }
    },
    "objectStore": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"mode": {"enum": ["garage", "external"]}}
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {"type": "string", "pattern": "^oci://"},
        "pullSecret": {"type": "string"}
      }
    },
    "reconcile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interval": {"type": "string"},
        "retryInterval": {"type": "string"},
        "timeout": {"type": "string"}
      }
    }
  }
}
