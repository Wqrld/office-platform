{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apps"
  ],
  "properties": {
    "apps": {
      "description": "One entry per application, in the shape charts/control-plane/apps.yaml documents in its header: the control plane hands every app's provisioning fields, enabled or not, over as TENANTS_JSON (adr/0107), merged over the one entry in values.yaml, Keycloak's own database.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "postgres": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "extensions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "databases": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "cache": {
            "type": "array",
            "items": {
              "enum": [
                "cache",
                "broker"
              ]
            },
            "minItems": 1
          },
          "acl": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cache": {
                "type": "string",
                "minLength": 1
              },
              "broker": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "oidc": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "description"
            ],
            "properties": {
              "shape": {
                "enum": [
                  "lasuite",
                  "login",
                  "resource-server"
                ]
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "redirect": {
                "type": "string",
                "pattern": "^/"
              },
              "accessTokenLifespan": {
                "type": "integer",
                "minimum": 60
              },
              "audiences": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "bucket": {
            "type": "boolean"
          },
          "search": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        }
      }
    },
    "valkeyAcl": {
      "description": "Each Valkey instance's ACL line for every app with a password there, before the app's own `acl` extras. Rendered as `valkey-<instance>-acl-values`, the ConfigMap the instance's HelmRelease reads `auth.aclUsers` from.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "cache",
        "broker"
      ],
      "properties": {
        "default": {
          "description": "No ambient access: with no NetworkPolicy enforcement (adr/0103) these ACLs are the only isolation between applications.",
          "type": "string",
          "minLength": 1
        },
        "cache": {
          "description": "`+flushdb` on the cache only: Django's `cache.clear()` calls it and fails with `ConnectionInterrupted` without it.",
          "type": "string",
          "minLength": 1
        },
        "broker": {
          "description": "No `+flushdb`: queued work lives here.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "legacyValkeyUsers": {
      "description": "Apps whose Valkey passwords were drawn before generation was per app, and live in `valkey-<instance>-users` beside `default`. A re-draw logs every user out, so they stay there.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "objectStore": {
      "description": "${S3_MODE}: bucket grants exist only when the platform runs the store.",
      "enum": [
        "garage",
        "external"
      ]
    },
    "tenant": {
      "description": "Apps live in <tenant>-<app>.",
      "type": "string",
      "minLength": 1
    },
    "namespaces": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "string"
        },
        "identity": {
          "type": "string"
        }
      }
    },
    "postgresCluster": {
      "type": "string"
    },
    "garageCluster": {
      "type": "string"
    },
    "passwordGenerator": {
      "type": "string"
    },
    "domain": {
      "description": "${BASE_DOMAIN}; the clients' URLs are https://<app>.<domain>.",
      "type": "string"
    },
    "keycloak": {
      "description": "The realm reconcile Job (templates/keycloak.yaml). keycloak-config-cli is built against one Keycloak minor; 6.5.1, built for 26.5, runs against the 26.7 server this platform pins (verified against 26.7.3). Move it with Keycloak (platform/identity/vendor/keycloak-operator).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        },
        "adminSecret": {
          "type": "string"
        },
        "smtpSecret": {
          "type": "string"
        },
        "image": {
          "type": "string"
        }
      }
    },
    "opensearch": {
      "description": "The OpenSearch security reconcile Job (templates/opensearch.yaml). The image is the server's own, for securityadmin.sh and hash.sh at the server's version: keep it at the tag platform/opensearch/cluster.yaml runs.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string"
        },
        "adminTlsSecret": {
          "type": "string"
        },
        "image": {
          "type": "string"
        }
      }
    }
  }
}
