# `<gitmoji> (<scope>) <imperative subject>` (CONTRIBUTING.md, Commits); not Conventional
# Commits, so `contrib-title-conventional-commits` stays off. The title regex is the gitmoji
# set, not "emoji": pictographs, arrows, media controls and dingbats, an optional variation
# selector (🔒️ has one, 🔧 not) and the zero-width joiner for 🧑‍💻. Python syntax: gitlint is
# Python, and PCRE's `\x{...}` is a config error that never lints.
[general]
ignore=body-is-missing

[title-match-regex]
regex=^[\U0001F000-\U0001FAFF←-⇿⏩-⏾☀-➿⬀-⯿]️?(?:‍[\U0001F000-\U0001FAFF]️?)* \([a-z0-9-]+\) .+$

[title-max-length]
line-length=80

# A URL or rendered line that cannot wrap goes in a fenced block, which gitlint ignores.
[body-max-line-length]
line-length=92
